{
  "PolicyName": "My2CustomerPolicy",
  "Description" : "This is the 2nd customer managed policy created by Pipeline",
  "Path": "/",
  "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Sid": "2ndPolicy",
                "Action": [
                    "s3:GetObject",
                    "s3:ListBucket",
                    "ec2:Describe*",
                    "cloudfront:Get*",
                    "cloudfront:List*"
                ],
              "Effect": "Allow",
              "Resource": "*"
            }
        ]
    },
  "Tags": []
}
