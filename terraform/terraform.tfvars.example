# Copie para terraform.tfvars e ajuste os valores.
#
# ExternalId (shared secret cross-account):
#   1) Gere o valor:        openssl rand -hex 32
#   2) Guarde-o em AWS Secrets Manager, p.ex.:
#        aws secretsmanager create-secret \
#          --name dev/cx-mgn-pipe/external-id \
#          --secret-string "<valor-gerado>"
#   3) Use esse NOME (ou o ARN) em external_id_secret_id abaixo.
# Use o MESMO VALOR do segredo no módulo terraform/deploy-role (contas-alvo).

region            = "us-east-1"
repository_type   = "GitHub"
repository_owner  = "dennisasilva"
repository_name   = "iam-cx-mng-pipeline"
branch_name       = "main"
naming_convention = "cx-mng-pipeline"
manual_approval   = true

# external_id_secret_id = "dev/cx-mgn-pipe/external-id"
