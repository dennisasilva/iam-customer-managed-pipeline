# Copie para terraform.tfvars e ajuste os valores.
#
# ExternalId: NAO coloque o valor em claro aqui nem em nenhuma variavel Terraform.
# Em vez disso, armazene o ExternalId em um secret do AWS Secrets Manager e
# passe o ARN completo desse secret em external_id_secret_arn. Com isso o
# valor em claro nao entra em variaveis, em Parameters, nem no state do
# Terraform. O mesmo valor em claro precisa ser usado no modulo
# terraform/deploy-role das contas-alvo (ver notas la).
#
# Passos (uma vez):
#   1) Gere o valor (16-64 chars):  openssl rand -hex 32
#   2) Armazene esse valor como SecretString de um secret do Secrets Manager.
#   3) Pegue o ARN retornado e cole no campo abaixo.

region            = "us-east-1"
repository_type   = "GitHub"
repository_owner  = "dennisasilva"
repository_name   = "iam-cx-mng-pipeline"
branch_name       = "main"
naming_convention = "cx-mng-pipeline"
manual_approval   = true

# external_id_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:cx-mng-pipeline/external-id-abcdef"
